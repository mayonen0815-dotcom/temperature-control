generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  storeCode String   @unique
  name      String
  pinHash   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  complaints             Complaint[]
  documents              Document[]
  checklistGroups        ChecklistGroup[]
  checklistAnswers       ChecklistAnswer[]
  checklistSubmissions   ChecklistSubmission[]
  employees              Employee[]
}

enum ComplaintStatus {
  NEW
  IN_PROGRESS
  DONE
}

model Complaint {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  title          String
  detail         String
  photoUrl       String?
  status         ComplaintStatus @default(NEW)
  staffName      String
  createdByAdmin Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([storeId])
}

enum DocumentStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model Document {
  id         String         @id @default(cuid())
  storeId    String
  store      Store          @relation(fields: [storeId], references: [id])
  staffName  String
  docType    String
  fileUrl    String
  fileName   String
  status     DocumentStatus @default(SUBMITTED)
  note       String?
  createdAt  DateTime       @default(now())

  @@index([storeId])
}

model ChecklistGroup {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  name              String
  referencePhotoUrl String?
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)

  items ChecklistItem[]

  @@index([storeId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  groupId   String
  group     ChecklistGroup @relation(fields: [groupId], references: [id])
  name      String
  guide     String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  answers ChecklistAnswer[]

  @@index([groupId])
}

model ChecklistAnswer {
  id            String   @id @default(cuid())
  itemId        String
  item          ChecklistItem @relation(fields: [itemId], references: [id])
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  logDate       DateTime
  passed        Boolean
  photoUrl      String?
  note          String?
  staffName     String
  editedByAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([itemId, logDate])
  @@index([storeId, logDate])
}

model ChecklistSubmission {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id])
  logDate          DateTime
  staffCondition   String
  absenceNote      String?
  confirmedBy      String
  submittedBy      String
  submittedByAdmin Boolean  @default(false)
  submittedAt      DateTime @default(now())

  @@unique([storeId, logDate])
  @@index([storeId, logDate])
}

model Employee {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  name       String
  address    String?
  hireDate   DateTime?
  resignDate DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  documents EmployeeDocument[]

  @@index([storeId])
}

// 従業員ごとの書類フォルダ（複数ファイルを保管できる）
model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  fileUrl    String
  fileName   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

model AdminUser {
  id           String @id @default(cuid())
  name         String
  passwordHash String
}
